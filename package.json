{
  "name": "legatograph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "check": "npm run typecheck && npm run lint && npm run test run",
    "prepare": "husky",
    "size": "size-limit",
    "hooks:detect": "tsx scripts/detect-hooks.ts",
    "horizons:backfill": "tsx scripts/backfill-horizons.ts",
    "reel:compose": "tsx scripts/compose-reel.ts",
    "reel:auto": "tsx scripts/reel-auto.ts",
    "db": "supabase --workdir data",
    "db:link": "supabase --workdir data link",
    "db:push": "supabase --workdir data db push",
    "db:diff": "supabase --workdir data db diff",
    "db:pull": "supabase --workdir data db pull",
    "db:status": "supabase --workdir data migration list",
    "db:new": "supabase --workdir data migration new",
    "db:repair": "supabase --workdir data migration repair"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@remotion/bundler": "^4.0.460",
    "@remotion/cli": "^4.0.460",
    "@remotion/google-fonts": "^4.0.461",
    "@remotion/renderer": "^4.0.460",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "fft.js": "^4.0.4",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "^4.0.460",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.2",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "size-limit": "^12.0.1",
    "supabase": "^2.101.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
