# Copy this file to .env.local and fill in real values
# .env.local is gitignored — never commit real secrets

NEXT_PUBLIC_APP_URL=http://localhost:3030

# Supabase (required for app layer — see docs/supabase.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify Web API (Client Credentials flow — used by hook detector for released tracks)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Drive API key (server-only — see docs/gdrive.md).
# Used as fallback for unauthenticated access to publicly-shared Drive folders.
# Optional if OAuth (below) is configured; required if you want to support
# folders without sign-in. Never expose to the browser.
GOOGLE_API_KEY=

# Google OAuth 2.0 client (server-only — see docs/gdrive.md "OAuth").
# Used so artists can sign in with Google and access private Drive folders,
# bypassing per-file anonymous download quotas. Create credentials at
# https://console.cloud.google.com/apis/credentials → Web application,
# add http://localhost:3030/api/integrations/google/callback as a redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Anthropic API (caption generator at /api/captions/draft).
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Secret used to authenticate Vercel-cron requests to /api/cron/*.
# Vercel sends `Authorization: Bearer <CRON_SECRET>` automatically when set.
# Generate any high-entropy string (eg `openssl rand -hex 32`).
CRON_SECRET=

# Post-Pulse — multi-platform social publishing for IG/TikTok/X/Threads/FB.
# Workspace-level API key from the Post-Pulse dashboard.
# Webhook secret is any high-entropy string you also paste into Post-Pulse's
# webhook config. See docs/post-pulse.md for setup.
POST_PULSE_API_KEY=
POST_PULSE_WEBHOOK_SECRET=
# Local-dev only: set to 1 to skip webhook signature verification. NEVER set
# in any deployed environment — the route refuses bypass when NODE_ENV=production.
POST_PULSE_WEBHOOK_DEV_BYPASS=

# Add project-specific variables below
