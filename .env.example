# Copy this file to .env.local and fill in real values
# .env.local is gitignored — never commit real secrets

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for app layer — see docs/supabase.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify Web API (Client Credentials flow — used by hook detector for released tracks)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Add project-specific variables below
